# Keep the files exactly as Home Assistant's Linux build expects them, whatever the
# operating system they are checked out or edited on: text with LF line endings,
# images and other binaries untouched.
* text=auto eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.db   binary
*.pdf  binary

# Vendored third-party files are kept byte for byte as released (their SHA-256 is checked):
# Leaflet's leaflet.css has CRLF line endings.
family_tree/app/static/vendor/** -text
